{
  "name": "colombia-quake-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Situation dashboard for the 10 August 2026 Mw 7.4 Colombia earthquake, focused on Cali and the Valle del Cauca region.",
  "type": "module",
  "scripts": {
    "prep": "node scripts/prep-data.mjs",
    "build": "node scripts/prep-data.mjs && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --watch",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check-science.mjs && node scripts/check-coverage.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "npm run build && npm run check && npm run verify"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^6.2.108"
  }
}
